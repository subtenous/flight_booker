<h1>Booking Confirmed</h1>

<div class="flight-summary">
	<h2>Flight Details</h2>
	<ul>
		<li><%= @booking.flight.departure_airport.code %> &rarr; <%= @booking.flight.arrival_airport.code %></li>
		<li><%= @booking.flight.start_datetime.strftime("%a, %d %b %Y at %H:%M") %></li>
		<li><%= @booking.flight.duration %> minutes</li>
	</ul>
</div>

<section class="passengers-section">
	<h2>Passengers</h2>
	<div class="passenger-list">
		<% @booking.passengers.each_with_index do |passenger, index| %>
			<div class="passenger-card">
				<h3>Passenger <%= index +1 %></h3>
				<p><strong>Name:</strong> <%= passenger.name %></p>
				<p><strong>Email:</strong> <%= passenger.email %></p>
			</div>
		<% end %>
	</div>
</section>



