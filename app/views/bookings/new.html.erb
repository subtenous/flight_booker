<h1> New Booking </h1>

<% if @booking.errors.any? %>
  <div class="error-messages">
    <h2>Please correct the following errors:</h2>

    <ul>
      <% @booking.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="flight-summary">
	<h2>Flight Details</h2>
	<ul>
		<li><%= @booking.flight.departure_airport.code %> &rarr; <%= @booking.flight.arrival_airport.code %></li>
		<li><%= @booking.flight.start_datetime.strftime("%a, %d %b %Y at %H:%M") %></li>
		<li><%= @booking.flight.duration %> minutes</li>
	</ul>
</div>
<section class="passenger-form">
	<%= form_with model: @booking, class: "booking-form" do |f| %>
		<%= f.hidden_field :flight_id %>

		<h2>Passenger Details</h2>
		<%= f.fields_for :passengers do |p_fields| %>
			<fieldset class="passenger">
				<legend>Passenger <%= p_fields.index + 1 %></legend>
							
				<div class="form-group">
					<%= p_fields.label :name, class: "form-label" %>
					<%= p_fields.text_field :name, class: "form-control"%>
				</div>

				<div class="form-group">
					<%= p_fields.label :email, class: "form-label" %>
					<%= p_fields.email_field :email, class: "form-control" %>
				</div>
			</fieldset>
		<% end %>

		<div class="booking-actions">
			<%= f.submit "Book Flight", class: "booking-button" %>
		</div>
	<% end %>
</section>